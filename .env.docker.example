# ============================================================
# Đảo Vàng — Environment variables cho Docker
# Copy file này thành .env.docker rồi sửa giá trị
# ============================================================

# System wall-clock timezone for logs, reports, scheduler metadata and UI
TZ=Asia/Ho_Chi_Minh

# Model production được chọn duy nhất trong configs/live.yaml và kiểm tra bằng CI.
# Không khai báo lại model ID trong file môi trường này.

# --- Telegram (tùy chọn, nhưng nên có để nhận alert 24/7) ---
# Xem docs/TELEGRAM_SETUP.md để tạo bot
DAO_VANG_TELEGRAM__BOT_TOKEN=
DAO_VANG_TELEGRAM__CHAT_ID=

# --- Web Public URL for Telegram deep links ---
DAO_VANG_WEB__PUBLIC_URL=https://daovang.comaygiauco.com

# --- REQUIRED: dashboard access password ---
# Leave empty only while preparing the file; the server fails closed without it.
DAO_VANG_WEB__ACCESS_PASSWORD=

# Direct Git updates are disabled by default; deploy through a reviewed release pipeline.
DAO_VANG_UPDATER__ENABLED=false

# --- Binance API (tùy chọn, chỉ cần nếu muốn tăng rate limit) ---
# Để trống = dùng public API (đủ cho scanner)
DAO_VANG_API_KEY=
DAO_VANG_API_SECRET=

# --- CoinGecko cross-reference (tùy chọn, chỉ đối chiếu giá) ---
# Bật để đối chiếu giá Binance vs CoinGecko (phát hiện manipulation)
DAO_VANG_COINGECKO__ENABLED=false

# --- Binance Agent OS market cap (nguồn chuẩn duy nhất cho market cap) ---
DAO_VANG_BINANCE_AGENT_OS__ENABLED=true
# DAO_VANG_BINANCE_AGENT_OS__TIMEOUT_SECONDS=10
# DAO_VANG_BINANCE_AGENT_OS__CACHE_MINUTES=15
# DAO_VANG_BINANCE_AGENT_OS__CHAIN_IDS=1,56,8453,CT_501

# Các tham số scanner không nhạy cảm được quản lý trong configs/live.yaml.
